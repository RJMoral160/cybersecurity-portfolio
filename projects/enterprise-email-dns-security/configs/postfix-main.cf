# artifact: reference-implementation
# Narrowed lab relay settings based on the recorded Postfix/Exchange architecture.
myhostname = mail.example.org
mydomain = example.org
myorigin = $mydomain
inet_interfaces = all
mydestination = localhost
mynetworks = 127.0.0.0/8, 172.24.25.12/32
relay_domains = example.org
transport_maps = hash:/etc/postfix/transport
smtpd_recipient_restrictions = permit_mynetworks, reject_unauth_destination
smtpd_tls_security_level = may
smtp_tls_security_level = may
# Set smtpd_tls_cert_file and smtpd_tls_key_file to local files outside this repository.
# DKIM and SpamAssassin milter endpoints. Deploy both local services before enabling.
smtpd_milters = inet:127.0.0.1:8891, inet:127.0.0.1:8893
non_smtpd_milters = inet:127.0.0.1:8891, inet:127.0.0.1:8893
milter_default_action = accept
milter_protocol = 6
