; artifact: reconstructed-from-project-records
; Authoritative example zone. Replace example values only in an isolated lab.
$TTL 300
@       IN SOA ns1.example.org. hostmaster.example.org. (
            2026100501 3600 900 604800 300 )
        IN NS  ns1.example.org.
        IN NS  ns2.example.org.
        IN MX  10 mail.example.org.
ns1     IN A   198.51.100.10
ns2     IN A   198.51.100.11
mail    IN A   198.51.100.12
owa     IN A   198.51.100.13
@       IN TXT "v=spf1 ip4:198.51.100.12 -all"
_dmarc  IN TXT "v=DMARC1; p=none; rua=mailto:dmarc@example.org"
; Publish the generated OpenDKIM public selector only after creating a local key.
; default._domainkey IN TXT "v=DKIM1; k=rsa; p=<generated-public-key>"
